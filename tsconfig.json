{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023", "webworker"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "useUnknownInCatchVariables": true,
    // El runner ejecuta TS directo con el type-stripping de Node
    // (modo strip-only): prohíbe sintaxis no borrable como las
    // parameter properties del constructor o los enums.
    "erasableSyntaxOnly": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}